# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Kid session signing (random long secret)
KID_SESSION_SECRET=change-me-to-a-long-random-string

# Unlocks /login (family register + parent/kid sign-in). Keep private.
FAMILY_ACCESS_CODE=change-me-family-access-code

# Cron / GitHub Action shared secret
CRON_SECRET=change-me-cron-secret

# AI — Google Gemini free tier (OpenAI-compatible)
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=your_gemini_api_key
# Tried in order on 429/404/quota: strongest free → … → lite
# (Pro free quota is 0 — omit unless billing enabled)
AI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Optional single override (prepended if AI_MODELS unset)
# AI_MODEL=gemini-3.6-flash

# Optional app URL for server-side calls
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
